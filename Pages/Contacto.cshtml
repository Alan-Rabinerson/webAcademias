@page "/contacto"
@model ContactoModel
@{
    ViewData["Title"] = "Contacto";
}
<section class="contacto" id="contacto">
    <h1 class="text-2xl font-bold mb-4 mt-4 text-center">Contacto</h1>
    <div class="contacto-container">
        <form action="/contacto" method="post" class="contacto-form">
            <input type="text" class="contacto-input" name="nombre" placeholder="Nombre" required>
            <input type="email" class="contacto-input" name="email" placeholder="Correo electrónico" required>
            <textarea class="contacto-textarea" name="mensaje" placeholder="Mensaje" required></textarea>
            <button type="submit" class="contacto-button">Enviar</button>
        </form>
        <div class="contacto-info">
            <h3 class="text-azul text-xl font-bold">Dirección</h3>
            <p class="direccion"><strong>Edifici Pau Seguí -<u> Ciutadella •</strong> c/ Comerciants, 9 </u>• Tlf. 971 381 550</p> 
            <p class="direccion"><u><strong>Maó •</strong> c/ Curniola, 17</u> • Tlf. 971 352 464</p>
            <p class="email"><strong>Email:</strong> <a href="mailto:academias@empresademenorca.org">academias@empresademenorca.org</a></p>
        </div>
    </div>
</section>